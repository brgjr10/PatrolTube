# YouTube Data API v3 key. Optional: without it the app falls back to HTML
# scraping, which YouTube throttles heavily. Never commit a real value — copy this
# file to .env, which is gitignored and now excluded from the Docker build context.
YOUTUBE_API_KEY=

# Comma-separated browser origins allowed to read the API cross-origin.
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Shared secret for POST /api/cache/refresh. Unset leaves that route open to
# anyone who can reach port 8001; set it and callers must send the same value in
# an X-Cache-Refresh-Token header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CACHE_REFRESH_TOKEN=

# Set to 1 to turn off /docs, /redoc and /openapi.json.
PATROLTUBE_DISABLE_DOCS=

# PATROLTUBE_UID / PATROLTUBE_GID were removed. They defaulted to 0:0, which
# overrode the image's USER appuser and ran the container as root. The cache now
# lives in a named volume owned by uid 10001, so the image user is used as-is.
# To run as someone else, set `user:` on the service in docker-compose.yml and
# chown the volume to that uid first.
